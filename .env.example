# Copy to .env and fill in. See README.md for the full guide.

# --- Auth (required) --------------------------------------------------------------------------
# There is no admin account to configure here: the first time you open the app it asks you to
# register the admin.
#
# Signs sessions. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL where users reach the app, with scheme and no trailing slash. Must match what the
# browser sees (behind a reverse proxy: your https:// domain), or login will fail.
BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed to call the auth API, comma-separated (optional).
# TRUSTED_ORIGINS=

# Key for encrypting secrets saved from the admin panel (SMTP password, Resend API key).
# Defaults to BETTER_AUTH_SECRET. Set it to rotate the auth secret without losing those settings.
# SETTINGS_ENCRYPTION_KEY=

# --- Database ---------------------------------------------------------------------------------
# Defaults to SQLite: the Docker image uses file:/data/seotools.db, on the /data volume.
# Docker Compose uses DATABASE_URL_DOCKER (not DATABASE_URL). For example:
# DATABASE_URL_DOCKER=postgres://user:password@db:5432/seotools
# DATABASE_URL_DOCKER=mysql://user:password@db:3306/seotools
# Direct docker run, Dokploy and local development use DATABASE_URL.
# PostgreSQL:  DATABASE_URL=postgres://user:password@host:5432/seotools
# MySQL:       DATABASE_URL=mysql://user:password@host:3306/seotools
#
# Local development (`pnpm dev`) runs web and worker from their own folders, so a relative
# SQLite path would give each its own database. Point both at the same file:
# DATABASE_URL=file:../../data/seotools.db
#
# Only needed if the dialect can't be inferred from the URL: sqlite | pg | mysql
# DATABASE_DIALECT=
# Apply pending migrations on startup.
# RUN_MIGRATIONS=true

# --- Server -----------------------------------------------------------------------------------
PORT=3000
# LOG_LEVEL=info

# --- Worker -----------------------------------------------------------------------------------
# A worker in its own container (SEOTOOLS_MODE=worker) needs BETTER_AUTH_URL too: the emails with
# password links point at it.
# WORKER_CONCURRENCY=2
# WORKER_POLL_INTERVAL_MS=1000
# JOB_LOCK_TIMEOUT_MS=300000
# Crawls running in parallel. They have their own slots, separate from WORKER_CONCURRENCY.
# CRAWL_CONCURRENCY=2
# The crawler refuses loopback, private and link-local addresses, so that a domain resolving to one
# cannot reach internal services. Set to true to audit sites on your own network.
# CRAWLER_ALLOW_PRIVATE_NETWORKS=false

# For a staging copy of a production database: the worker fires no scheduled crawls, runs no
# periodic refreshes or update checks and sends no email (alerts, invitations, password links, test
# sends). What a user starts from the UI (a crawl, a recheck) still runs.
# SEOTOOLS_PAUSE_AUTOMATION=false

# --- Docker only ------------------------------------------------------------------------------
# all (web + worker in one container) | web | worker | migrate
# SEOTOOLS_MODE=all
# The image Docker Compose runs. Defaults to the newest stable release (:latest). Pin the version
# you chose: :0.2.1 is exactly that release, :0.2 follows its patches. See docs/updating.md.
# SEOTOOLS_IMAGE=ghcr.io/vhxa/seotools:latest
