{
  "name": "seotools",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Open source, self-hosted SEO toolkit.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm db:bootstrap && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @seotools/db generate",
    "db:check": "pnpm --filter @seotools/db check",
    "db:bootstrap": "pnpm --filter @seotools/worker bootstrap",
    "release:check": "node scripts/release.mjs check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@seotools/core": "workspace:*",
    "@seotools/db": "workspace:*",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
